{% comment %}
  Winfluencer App Embed Block
  Purpose: Capture wf_id from URL → cart attributes (+ localStorage as backup)
  Cart attributes do NOT require cookie consent — they are first-party functional data.
  This is the ONLY storefront-side code. All event tracking is handled
  by the Custom Pixel via Shopify's Web Pixels API.
{% endcomment %}

<script>
(function(){
  'use strict';

  /* 1. Get wf_id from URL param (primary source) */
  var wfId = '';
  try {
    var params = new URLSearchParams(window.location.search);
    wfId = params.get('wf_id') || '';
  } catch(e) {}

  /* 2. If not in URL, try localStorage as backup (may fail without consent) */
  if (!wfId) {
    try { wfId = localStorage.getItem('wf_id') || ''; } catch(e) {}
  }

  /* 3. Write cart attributes — always fetch cart first to get token */
  fetch('/cart.js').then(function(r){ return r.json(); }).then(function(cart) {
    var cartToken = cart.token || '';
    var attrs = {};
    var needsUpdate = false;

    /* 3a. Write wf_id if we have one */
    if (wfId) {
      try { localStorage.setItem('wf_id', wfId); } catch(e) {}
      if (cart.attributes.wf_influencer_id !== wfId) {
        attrs.wf_influencer_id = wfId;
        needsUpdate = true;
      }
    }

    /* 3b. Always write cart token as session ID */
    if (cartToken && cart.attributes.wf_session_id !== cartToken) {
      attrs.wf_session_id = cartToken;
      needsUpdate = true;
    }

    if (needsUpdate) {
      fetch('/cart/update.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ attributes: attrs })
      }).catch(function(){});
    }
  }).catch(function(){});

  /* 4. Re-sync cart attribute after any add-to-cart or cart-change */
  try {
    var origFetch = window.fetch;
    window.fetch = function() {
      var url = arguments[0];
      if (typeof url === 'string' && (url.indexOf('/cart/add') !== -1 || url.indexOf('/cart/change') !== -1)) {
        var storedWf = '';
        try {
          var p = new URLSearchParams(window.location.search);
          storedWf = p.get('wf_id') || '';
        } catch(e) {}
        if (!storedWf) {
          try { storedWf = localStorage.getItem('wf_id') || ''; } catch(e) {}
        }
        if (storedWf) {
          var of = origFetch;
          setTimeout(function() {
            of('/cart/update.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ attributes: { 'wf_influencer_id': storedWf } })
            }).catch(function(){});
          }, 500);
        }
      }
      return origFetch.apply(this, arguments);
    };
  } catch(e) {}
})();
</script>

{% schema %}
{
  "name": "Winfluencer Tracking",
  "target": "body",
  "settings": []
}
{% endschema %}
