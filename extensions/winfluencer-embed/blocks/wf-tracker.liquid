{% comment %}
  Winfluencer App Embed Block
  Purpose: Capture wf_id from URL → cart attributes (+ localStorage as backup)
  Cart attributes do NOT require cookie consent — they are first-party functional data.
  This is the ONLY storefront-side code. All event tracking is handled
  by the Custom Pixel via Shopify's Web Pixels API.
{% endcomment %}

<script>
(function(){
  'use strict';

  /* 1. Get wf_id from URL param (primary source) */
  var wfId = '';
  try {
    var params = new URLSearchParams(window.location.search);
    wfId = params.get('wf_id') || '';
  } catch(e) {}

  /* 2. If not in URL, try localStorage as backup (may fail without consent) */
  if (!wfId) {
    try { wfId = localStorage.getItem('wf_id') || ''; } catch(e) {}
  }

  /* 3. Write cart attributes — always fetch cart first to get token */
  fetch('/cart.js').then(function(r){ return r.json(); }).then(function(cart) {
    var cartToken = cart.token || '';
    var attrs = {};
    var needsUpdate = false;

    /* 3a. Write wf_id if we have one */
    if (wfId) {
      try { localStorage.setItem('wf_id', wfId); } catch(e) {}
      if (cart.attributes.wf_influencer_id !== wfId) {
        attrs.wf_influencer_id = wfId;
        needsUpdate = true;
      }
    }

    /* 3b. Always write cart token as session ID (cart attrs + localStorage) */
    if (cartToken) {
      try { localStorage.setItem('wf_session_id', cartToken); } catch(e) {}
      if (cart.attributes.wf_session_id !== cartToken) {
        attrs.wf_session_id = cartToken;
        needsUpdate = true;
      }
    }

    if (needsUpdate) {
      fetch('/cart/update.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ attributes: attrs })
      }).catch(function(){});
    }
  }).catch(function(){});

  /* 4. Cart attributes set on page load persist through all add-to-cart and
        cart-change actions for the session. No fetch interception needed.
        The pixel's browser.localStorage is the fallback for checkout. */
})();
</script>

{% schema %}
{
  "name": "Winfluencer Tracking",
  "target": "body",
  "settings": []
}
{% endschema %}
