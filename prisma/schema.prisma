generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id                String    @id
  shop              String
  state             String
  isOnline          Boolean   @default(false)
  scope             String?
  expires           DateTime?
  accessToken       String
  userId            BigInt?
  firstName         String?
  lastName          String?
  email             String?
  accountOwner      Boolean   @default(false)
  locale            String?
  collaborator      Boolean?  @default(false)
  emailVerified     Boolean?  @default(false)
  refreshToken      String?
  refreshTokenExpires DateTime?
}

model Store {
  id          String    @id @default(cuid())
  shop        String    @unique
  accessToken String
  pixelId     String    @unique @default(cuid())
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  campaigns   Campaign[]
  events      Event[]
  orders      Order[]
  teamMembers TeamMember[]
  touchpoints Touchpoint[]
}

model Campaign {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  name        String
  status      String   @default("active")
  startDate   DateTime?
  endDate     DateTime?
  budget      Float?
  createdAt   DateTime @default(now())
  influencers Influencer[]
}

model Influencer {
  id           String   @id @default(cuid())
  campaignId   String
  campaign     Campaign @relation(fields: [campaignId], references: [id])
  name         String
  handle       String
  platform     String   @default("instagram")
  wfId         String   @unique
  targetUrl    String
  trackingUrl  String
  createdAt    DateTime @default(now())
  events       Event[]
  orders       Order[]
  touchpoints  Touchpoint[]
}

model Event {
  id             String   @id @default(cuid())
  storeId        String
  store          Store    @relation(fields: [storeId], references: [id])
  influencerId   String?
  influencer     Influencer? @relation(fields: [influencerId], references: [id])
  wfId           String?
  sessionId      String
  eventType      String
  productId      String?
  productTitle   String?
  variantId      String?
  variantTitle   String?
  price          Float?
  quantity       Int?
  pageUrl        String?
  timestamp      DateTime @default(now())

  @@index([storeId, eventType])
  @@index([influencerId, eventType])
}

model Order {
  id             String   @id @default(cuid())
  storeId        String
  store          Store    @relation(fields: [storeId], references: [id])
  influencerId   String?
  influencer     Influencer? @relation(fields: [influencerId], references: [id])
  shopifyOrderId String
  wfId           String?
  totalPrice     Float
  currency       String   @default("USD")
  lineItems      Json
  createdAt      DateTime @default(now())

  @@index([storeId])
  @@index([influencerId])
}

model TeamMember {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id])
  email      String
  name       String
  role       String   @default("viewer")
  invitedAt  DateTime @default(now())
  acceptedAt DateTime?

  @@unique([storeId, email])
}

model Touchpoint {
  id            String      @id @default(cuid())
  storeId       String
  store         Store       @relation(fields: [storeId], references: [id])
  sessionId     String
  wfId          String
  influencerId  String?
  influencer    Influencer? @relation(fields: [influencerId], references: [id])
  touchIndex    Int
  timestamp     DateTime
  createdAt     DateTime    @default(now())

  @@unique([sessionId, wfId])
  @@index([storeId, sessionId])
  @@index([influencerId])
  @@index([sessionId, touchIndex])
}
